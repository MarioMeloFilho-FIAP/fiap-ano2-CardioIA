    {
        "id": "n_validar",
        "type": "function",
        "z": "f1a2b3c4.d5e6f7",
        "name": "Validar Sample_Record",
        "func": "// Validação de Sample_Record (R9.5, R11.6)\nvar d = msg.payload;\nif (typeof d !== 'object' || d === null) {\n    flow.set('msg_invalidas', (flow.get('msg_invalidas') || 0) + 1);\n    return [null, {payload: flow.get('msg_invalidas')}];\n}\nvar required = ['timestamp', 'temperatura', 'umidade', 'bpm', 'paciente_id'];\nvar keys = Object.keys(d);\nfor (var i = 0; i < required.length; i++) {\n    if (keys.indexOf(required[i]) === -1) {\n        flow.set('msg_invalidas', (flow.get('msg_invalidas') || 0) + 1);\n        return [null, {payload: flow.get('msg_invalidas')}];\n    }\n}\nif (typeof d.paciente_id !== 'string' || d.paciente_id.length === 0) {\n    flow.set('msg_invalidas', (flow.get('msg_invalidas') || 0) + 1);\n    return [null, {payload: flow.get('msg_invalidas')}];\n}\nif (typeof d.timestamp !== 'number' || d.timestamp < 0) {\n    flow.set('msg_invalidas', (flow.get('msg_invalidas') || 0) + 1);\n    return [null, {payload: flow.get('msg_invalidas')}];\n}\nif (d.bpm !== null) {\n    if (typeof d.bpm !== 'number' || d.bpm < 0 || d.bpm > 250) {\n        flow.set('msg_invalidas', (flow.get('msg_invalidas') || 0) + 1);\n        return [null, {payload: flow.get('msg_invalidas')}];\n    }\n}\nif (d.temperatura !== null) {\n    if (typeof d.temperatura !== 'number' || d.temperatura < -40.0 || d.temperatura > 80.0) {\n        flow.set('msg_invalidas', (flow.get('msg_invalidas') || 0) + 1);\n        return [null, {payload: flow.get('msg_invalidas')}];\n    }\n}\nif (d.umidade !== null) {\n    if (typeof d.umidade !== 'number' || d.umidade < 0 || d.umidade > 100) {\n        flow.set('msg_invalidas', (flow.get('msg_invalidas') || 0) + 1);\n        return [null, {payload: flow.get('msg_invalidas')}];\n    }\n}\nreturn [msg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "flow.set('msg_invalidas', 0);",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 200,
        "wires": [["n_prep_bpm", "n_prep_temp", "n_prep_umidade", "n_alert_module", "n_destaque_anomalo"], ["n_ui_msg_invalidas"]]
    },

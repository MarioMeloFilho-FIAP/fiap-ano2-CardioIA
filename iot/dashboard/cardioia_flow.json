    {
        "id": "n_alert_module",
        "type": "function",
        "z": "f1a2b3c4.d5e6f7",
        "name": "Alert_Module",
        "func": "// Alert_Module (R11.1, R11.2, R11.3, R11.4, R11.5)\nvar d = msg.payload;\nvar BPM_THRESHOLD = flow.get('bpm_threshold') || 120;\nvar TEMP_THRESHOLD = flow.get('temp_threshold') || 38.0;\n\nvar bpmAlto = (d.bpm !== null && d.bpm > BPM_THRESHOLD);\nvar tempAlta = (d.temperatura !== null && d.temperatura > TEMP_THRESHOLD);\n\nvar alertBpm, alertTemp, statusNormal;\n\nif (bpmAlto) {\n    alertBpm = {payload: 'ALERTA: BPM elevado', color: '#f44336'};\n} else {\n    alertBpm = {payload: 'Normal', color: '#4caf50'};\n}\n\nif (tempAlta) {\n    alertTemp = {payload: 'ALERTA: Temperatura elevada', color: '#f44336'};\n} else {\n    alertTemp = {payload: 'Normal', color: '#4caf50'};\n}\n\nif (!bpmAlto && !tempAlta) {\n    statusNormal = {payload: 'Normal', color: '#4caf50'};\n} else {\n    var textos = [];\n    if (bpmAlto) textos.push('BPM elevado');\n    if (tempAlta) textos.push('Temperatura elevada');\n    statusNormal = {payload: 'ALERTA: ' + textos.join(' + '), color: '#f44336'};\n}\n\n// Log interno (R11.5)\nif (bpmAlto || tempAlta) {\n    var logEntry = {timestamp: d.timestamp, paciente_id: d.paciente_id, metricas: [], valores: []};\n    if (bpmAlto) { logEntry.metricas.push('bpm'); logEntry.valores.push(d.bpm); }\n    if (tempAlta) { logEntry.metricas.push('temperatura'); logEntry.valores.push(d.temperatura); }\n    node.warn(JSON.stringify(logEntry));\n}\n\nreturn [alertBpm, alertTemp, statusNormal];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 320,
        "wires": [["n_ui_alerta_bpm"], ["n_ui_alerta_temp"], ["n_ui_status_normal"]]
    },

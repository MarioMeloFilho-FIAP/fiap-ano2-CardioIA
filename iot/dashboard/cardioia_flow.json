    {
        "id": "n_destaque_anomalo",
        "type": "function",
        "z": "f1a2b3c4.d5e6f7",
        "name": "Destaque anômalo",
        "func": "// Destaque de ponto anômalo (R9.6)\n// Mantém o último ponto anômalo em destaque por 5 s\nvar d = msg.payload;\nvar BPM_THRESHOLD = flow.get('bpm_threshold') || 120;\nvar TEMP_THRESHOLD = flow.get('temp_threshold') || 38.0;\n\nvar anomalo = false;\nvar detalhe = [];\n\nif (d.bpm !== null && d.bpm > BPM_THRESHOLD) {\n    anomalo = true;\n    detalhe.push('BPM=' + d.bpm);\n}\nif (d.temperatura !== null && d.temperatura > TEMP_THRESHOLD) {\n    anomalo = true;\n    detalhe.push('Temp=' + d.temperatura + '°C');\n}\n\nif (anomalo) {\n    flow.set('ultimo_anomalo', {\n        timestamp: Date.now(),\n        detalhe: detalhe.join(', '),\n        paciente_id: d.paciente_id\n    });\n    msg.payload = '⚠ ' + detalhe.join(' | ') + ' [' + d.paciente_id + ']';\n    msg.color = '#f44336';\n    var prev = context.get('timeout');\n    if (prev) clearTimeout(prev);\n    var timeout = setTimeout(function() {\n        node.send({payload: '', color: '#4caf50'});\n    }, 5000);\n    context.set('timeout', timeout);\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "var t = context.get('timeout');\nif (t) clearTimeout(t);",
        "libs": [],
        "x": 810,
        "y": 560,
        "wires": [["n_ui_destaque"]]
    },

    {
        "id": "n_limites_atuais",
        "type": "function",
        "z": "f1a2b3c4.d5e6f7",
        "name": "Formatar Limites",
        "func": "// Atualiza limites atuais no dashboard (R16.4)\nvar cfg = msg.payload;\nvar bpmThr = cfg.bpm_threshold || 120;\nvar tempThr = cfg.temp_threshold || 38.0;\nvar interval = cfg.sampling_interval_ms || 5000;\n\n// Atualizar variáveis de fluxo para uso no Alert_Module\nflow.set('bpm_threshold', bpmThr);\nflow.set('temp_threshold', tempThr);\n\nmsg.payload = 'BPM: >' + bpmThr + ' | Temp: >' + tempThr + '°C | Intervalo: ' + (interval/1000) + 's';\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
